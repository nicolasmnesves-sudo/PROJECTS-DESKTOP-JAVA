<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="silosgroup.projetosystem_silo.TelaLoginController"
           style="-fx-background-color: #f4f6f8;">

    <VBox fx:id="loginBox"
          maxWidth="350"
          spacing="15"
          alignment="CENTER"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30;">

        <Label text="Login"
               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

        <TextField fx:id="loginUsuario"
                   promptText="Usuário"
                   maxWidth="280"/>

        <PasswordField fx:id="loginSenha"
                       promptText="Senha"
                       maxWidth="280"/>

        <Button text="Entrar"
                onAction="#entrar"
                maxWidth="280"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

        <Button text="Cadastrar usuário"
                onAction="#mostrarCadastro"
                maxWidth="280"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #2563eb;"/>

    </VBox>


    <VBox fx:id="cadastroBox"
          maxWidth="350"
          spacing="15"
          alignment="CENTER"
          visible="false"
          managed="false"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30;">

        <Label text="Cadastrar usuário"
               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

        <TextField fx:id="cadastroUsuario"
                   promptText="Novo usuário"
                   maxWidth="280"/>

        <PasswordField fx:id="cadastroSenha"
                       promptText="Nova senha"
                       maxWidth="280"/>

        <PasswordField fx:id="cadastroConfirmarSenha"
                       promptText="Confirmar senha"
                       maxWidth="280"/>

        <Button text="Cadastrar"
                onAction="#cadastrarUsuario"
                maxWidth="280"
                style="-fx-background-color: #16a34a;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

        <Button text="Voltar para login"
                onAction="#voltarLogin"
                maxWidth="280"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #2563eb;"/>

    </VBox>

</StackPane>
