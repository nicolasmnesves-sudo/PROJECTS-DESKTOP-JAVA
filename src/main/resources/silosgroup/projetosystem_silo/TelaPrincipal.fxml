<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1180.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="silosgroup.projetosystem_silo.TelaPrincipalController">


    <top>
        <VBox spacing="0">

            <HBox fx:id="headerEtiqueta" alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: #1976D2; -fx-padding: 12 20 12 20;">
                <Label text="PEDIDO #4829 - SILO 500T"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="ETIQUETA FÍSICA: AZUL"
                       style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.25); -fx-padding: 5 12 5 12; -fx-background-radius: 4;" />
            </HBox>


            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: #F4F5F7; -fx-padding: 12 20 12 20; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">

                <Label text="Aguardando Bip:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #333333;" />

                <TextField fx:id="txtLeituraBarcode" prefWidth="360" promptText="Aproxime o leitor de código de barras..."
                           style="-fx-font-size: 14px; -fx-padding: 6 10 6 10; -fx-border-color: #1976D2; -fx-border-radius: 3;" />

                <Separator orientation="VERTICAL" prefHeight="25" />

                <ToggleButton fx:id="btnOcultarSeparados" text="Ocultar Já Separados"
                              style="-fx-font-size: 12px; -fx-cursor: hand;" />

                <TextField fx:id="txtFiltroTexto" prefWidth="220" promptText="Buscar peça ou código..."
                           style="-fx-font-size: 12px; -fx-padding: 6;" />
            </HBox>
        </VBox>
    </top>


    <center>
        <TreeTableView fx:id="treeTableExpedicao" showRoot="false">
            <columns>
                <TreeTableColumn fx:id="colDescricao" prefWidth="420" text="Conjunto / Subconjunto / Peça" />
                <TreeTableColumn fx:id="colCodigo" prefWidth="160" text="Código / Barcode" />
                <TreeTableColumn fx:id="colTipo" prefWidth="120" text="Categoria" />
                <TreeTableColumn fx:id="colQuantidade" prefWidth="120" text="Qtd. (Lida/Total)" />
                <TreeTableColumn fx:id="colStatus" prefWidth="130" text="Status" />
            </columns>
            <columnResizePolicy>
                <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TreeTableView>
    </center>


    <right>
        <VBox prefWidth="290" spacing="15"
              style="-fx-background-color: #FAFAFA; -fx-padding: 20; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 0 1;">

            <!-- Card 1: Progresso Geral -->
            <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #666666;" text="PROGRESSO DA EXPEDIÇÃO" />
                <ProgressBar fx:id="barraProgresso" prefHeight="18" prefWidth="250" progress="0.76" />
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblPorcentagem" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="76%" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblContadorItens" style="-fx-font-size: 12px; -fx-text-fill: #555555;" text="380 / 500 itens" />
                </HBox>
            </VBox>


            <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #666666;" text="ÚLTIMO ITEM LIDO" />
                <Label fx:id="lblUltimoCodigo" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" text="CÓDIGO: #9042" />
                <Label fx:id="lblUltimaDescricao" style="-fx-font-size: 12px; -fx-text-fill: #444444;" text="Chapa Galvanizada 2mm - Virola Inferior" wrapText="true" />
                <Label fx:id="lblUltimoHorario" style="-fx-font-size: 10px; -fx-text-fill: #888888;" text="Lido às: 15:23:04" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Botões de Ação -->
            <VBox spacing="10">
                <Button fx:id="btnReportarDivergencia" prefHeight="40" prefWidth="250"
                        style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Reportar Divergência" />

                <Button fx:id="btnFinalizarExpedicao" prefHeight="40" prefWidth="250"
                        style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Finalizar Expedição" />
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox spacing="15" style="-fx-background-color: #263238; -fx-padding: 6 15 6 15;">
            <Label style="-fx-text-fill: #B0BEC5; -fx-font-size: 11px;" text="Operador: Expedição Metalmecânica" />
            <Separator opacity="0.3" orientation="VERTICAL" prefHeight="10" />
            <Label style="-fx-text-fill: #81C784; -fx-font-size: 11px;" text="● Leitor USB Ativo (HID)" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #B0BEC5; -fx-font-size: 11px;" text="KF Steel v1.0" />
        </HBox>
    </bottom>

</BorderPane>