<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nicolasmneves.demojogorpgjava.ControllerBatalha">
<children>
    <ImageView fx:id="minhaImagem" fitHeight="463.0" fitWidth="806.0" layoutX="-3.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../../Imagens/play%20-%20Copia.png" />
        </image></ImageView>
      <ProgressBar fx:id="vidaPersonagem" layoutX="21.0" layoutY="14.0" prefHeight="30.0" prefWidth="314.0" progress="0.0" />
      <ProgressBar fx:id="manaPersonagem" layoutX="21.0" layoutY="53.0" prefWidth="200.0" progress="0.0" />
      <ProgressBar fx:id="manaInimigo" layoutX="474.0" layoutY="53.0" prefWidth="200.0" progress="0.0" />
      <ProgressBar fx:id="vidaInimigo" layoutX="474.0" layoutY="14.0" prefHeight="30.0" prefWidth="314.0" progress="0.0" />
      <HBox layoutX="474.0" layoutY="369.0" prefHeight="55.0" prefWidth="244.0" spacing="50.0" style="-fx-background-color: WHITE;">
         <children>
            <Button fx:id="bntATA" mnemonicParsing="false" onAction="#bntClickATA" text="ATA" />
            <Button fx:id="bntDEF" mnemonicParsing="false" onAction="#bntClickDEF" text="DEF" />
            <Button fx:id="bntHAB" mnemonicParsing="false" onAction="#bntClickHAB" text="HAB" />
         </children>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <effect>
            <Lighting>
               <bumpInput>
                  <Shadow />
               </bumpInput>
               <light>
                  <Light.Distant />
               </light>
            </Lighting>
         </effect>
         <padding>
            <Insets left="7.0" right="7.0" top="13.0" />
         </padding></HBox>
      <Label fx:id="lblMensagem" layoutX="400.0" layoutY="321.0" prefHeight="47.0" prefWidth="392.0" textFill="#e1e1e1">
         <font>
            <Font name="Consolas Bold" size="21.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
